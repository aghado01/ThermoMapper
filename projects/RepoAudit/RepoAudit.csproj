<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RepoAudit</AssemblyName>
    <RootNamespace>RepoAudit</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RepoAudit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\repo-audit\**\*.cs" Link="RepoAudit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
