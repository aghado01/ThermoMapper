<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Archivory</RootNamespace>
    <AssemblyName>Archivory</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core = archivory root primitives only (BinarySerialization, ArtifactFile, …).
         Non-recursive include: each specialization is a sub-namespace with its own
         project under src/archivory/<name>/ (Archivory.Tabular, Archivory.Jso, …), so
         the core never reaches into a subdir and needs no exclude. A new core subdir
         would surface as a repo-audit orphan — by design. -->
    <Compile Include="..\..\src\archivory\*.cs"
      Link="archivory\%(Filename)%(Extension)" />
  </ItemGroup>


</Project>
