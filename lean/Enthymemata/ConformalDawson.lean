theorem rfCertC13S (t : ℝ) (ha : (0 : ℝ) ≤ t) (hb : t ≤ (4 : ℝ)) :
    0 ≤ (41060 / 10000 : ℝ) - (rfEnvInt (((1351 / 1000 : ℝ) + t) ^ 2 / 32) - rfEnvInt (t ^ 2 / 32))
      := by
  rw [rfPC13S_eq]
  rcases le_or_gt t (2 : ℝ) with h0 | h0
  · exact rfCertC13S_0 t (by linarith) h0
  rcases le_or_gt t (5 / 2 : ℝ) with h1 | h1
  · exact rfCertC13S_1 t (by linarith) h1
  rcases le_or_gt t (3 : ℝ) with h2 | h2
  · exact rfCertC13S_2 t (by linarith) h2
  exact rfCertC13S_3 t (by linarith) (by linarith)
/-! #### Φ's bracket on `[0, 16]` and `g`'s lower bound -/

theorem rfM_pos {t : ℝ} (ht : 0 ≤ t) : 0 < rfM t := by
  unfold rfM; positivity

theorem rfN_pos {t : ℝ} (h0 : 0 ≤ t) (h1 : t ≤ 1) : 0 < rfN t := by
  unfold rfN
  nlinarith [pow_nonneg h0 2, pow_nonneg h0 3, pow_nonneg h0 4, pow_nonneg h0 5]

theorem rfB_pos {t : ℝ} (h0 : 0 ≤ t) (h1 : t ≤ 1) : 0 < rfB t := by
  unfold rfB; exact mul_pos (by linarith) (rfN_pos h0 h1)

theorem rfNlo_pos {t : ℝ} (h0 : 0 ≤ t) (h1 : t ≤ 1) : 0 < rfNlo t := by
  unfold rfNlo; exact mul_pos (by linarith) (rfN_pos h0 h1)

theorem rf_hasDerivAt_div16 {f f' : ℝ → ℝ} (hf : ∀ t, HasDerivAt f (f' t) t) (x : ℝ) :
    HasDerivAt (fun x => f (x / 16)) (f' (x / 16) / 16) x := by
  have := (hf (x / 16)).comp x ((hasDerivAt_id x).div_const 16)
  exact this.congr_deriv (by ring)

/-- The upper bracket `B/M` at `t = x/16` and its derivative in `x`. -/
theorem rf_hasDerivAt_hi (x : ℝ) (hx : 0 ≤ x) :
    HasDerivAt (fun x => rfB (x / 16) / rfM (x / 16))
      ((((1 / 50000 : ℝ) * rfN (x / 16) + (1 + (1 / 50000 : ℝ) * (x / 16)) * rfNd (x / 16)) *
          rfM (x / 16) - rfB (x / 16) * rfMd (x / 16)) / rfM (x / 16) ^ 2 / 16) x := by
  have hN := rf_hasDerivAt_div16 hasDerivAt_rfN x
  have hM := rf_hasDerivAt_div16 hasDerivAt_rfM x
  have hL : HasDerivAt (fun x : ℝ => 1 + (1 / 50000 : ℝ) * (x / 16)) ((1 / 50000 : ℝ) / 16) x := by
    have := (((hasDerivAt_id x).div_const 16).const_mul (1 / 50000 : ℝ)).const_add 1
    exact this.congr_deriv (by ring)
  have hB := hL.mul hN
  have hM0 : rfM (x / 16) ≠ 0 := (rfM_pos (by linarith)).ne'
  have := hB.div hM hM0
  unfold rfB
  exact this.congr_deriv (by simp only [Pi.mul_apply]; field_simp)

/-- The lower bracket `Nlo/M` and its derivative. -/
theorem rf_hasDerivAt_lo (x : ℝ) (hx : 0 ≤ x) :
    HasDerivAt (fun x => rfNlo (x / 16) / rfM (x / 16))
      (((-(1 / 50000 : ℝ) * rfN (x / 16) + (1 - (1 / 50000 : ℝ) * (x / 16)) * rfNd (x / 16)) *
          rfM (x / 16) - rfNlo (x / 16) * rfMd (x / 16)) / rfM (x / 16) ^ 2 / 16) x := by
  have hN := rf_hasDerivAt_div16 hasDerivAt_rfN x
  have hM := rf_hasDerivAt_div16 hasDerivAt_rfM x
  have hL : HasDerivAt (fun x : ℝ => 1 - (1 / 50000 : ℝ) * (x / 16))
      (-((1 / 50000 : ℝ) / 16)) x := by
    have := (((hasDerivAt_id x).div_const 16).const_mul (1 / 50000 : ℝ)).const_sub 1
    exact this.congr_deriv (by ring)
  have hB := hL.mul hN
  have hM0 : rfM (x / 16) ≠ 0 := (rfM_pos (by linarith)).ne'
  have := hB.div hM hM0
  unfold rfNlo
  exact this.congr_deriv (by simp only [Pi.mul_apply]; field_simp)

/-- `Φ ≤ B/M` on `[0, 16]`, by comparison: the bracket is a supersolution of Φ's ODE. -/
theorem rfPhi_le_hi {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 16) :
    kummerHalf x ≤ rfB (x / 16) / rfM (x / 16) := by
  have key := nonneg_of_ode_ge (D := fun x => rfB (x / 16) / rfM (x / 16) - kummerHalf x)
    (x₀ := 0) (x₁ := 16) le_rfl
    (fun x hx => (rf_hasDerivAt_hi x hx.1).sub (hasDerivAt_kummerHalf x))
    (fun x hx => by
      have ht0 : 0 ≤ x / 16 := by linarith [hx.1]
      have ht1 : x / 16 ≤ 1 := by linarith [hx.2]
      have hM := rfM_pos ht0
      have e := rfRhi_spec (x / 16)
      have o := kummerHalf_ode x
      have c2 := rfCertC2 (x / 16) ht0 ht1
      have k1 : 2 * x * ((((1 / 50000 : ℝ) * rfN (x / 16) + (1 + (1 / 50000 : ℝ) * (x / 16)) *
          rfNd (x / 16)) * rfM (x / 16) - rfB (x / 16) * rfMd (x / 16)) / rfM (x / 16) ^ 2 / 16) +
          (1 + 2 * x) * (rfB (x / 16) / rfM (x / 16)) - 1 =
          x / 16 * rfRhi (x / 16) / rfM (x / 16) ^ 2 := by
        rw [eq_div_iff (pow_ne_zero 2 hM.ne'), ← e]
        field_simp
        ring
      have hval : 2 * x * ((((1 / 50000 : ℝ) * rfN (x / 16) + (1 + (1 / 50000 : ℝ) * (x / 16)) *
          rfNd (x / 16)) * rfM (x / 16) - rfB (x / 16) * rfMd (x / 16)) / rfM (x / 16) ^ 2 / 16 -
            (-kummerHalf x + exp (-x) * kummerMoment 1 x)) +
          (1 + 2 * x) * (rfB (x / 16) / rfM (x / 16) - kummerHalf x) =
          x / 16 * rfRhi (x / 16) / rfM (x / 16) ^ 2 := by
        rw [← k1]
        linarith [o]
      rw [hval]
      exact div_nonneg (mul_nonneg ht0 c2) (sq_nonneg _))
    (by simp [kummerHalf_zero, rfB, rfN, rfM])
  exact sub_nonneg.1 (key x ⟨h0, h1⟩)

/-- `Nlo/M ≤ Φ` on `[0, 16]`: the lower bracket is a subsolution. -/
theorem rfPhi_ge_lo {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 16) :
    rfNlo (x / 16) / rfM (x / 16) ≤ kummerHalf x := by
  have key := nonneg_of_ode_ge (D := fun x => kummerHalf x - rfNlo (x / 16) / rfM (x / 16))
    (x₀ := 0) (x₁ := 16) le_rfl
    (fun x hx => (hasDerivAt_kummerHalf x).sub (rf_hasDerivAt_lo x hx.1))
    (fun x hx => by
      have ht0 : 0 ≤ x / 16 := by linarith [hx.1]
      have ht1 : x / 16 ≤ 1 := by linarith [hx.2]
      have hM := rfM_pos ht0
      have e := rfRlo_spec (x / 16)
      have o := kummerHalf_ode x
      have c1 := rfCertC1 (x / 16) ht0 ht1
      have k1 : 2 * x * (((-(1 / 50000 : ℝ) * rfN (x / 16) + (1 - (1 / 50000 : ℝ) * (x / 16)) *
          rfNd (x / 16)) * rfM (x / 16) - rfNlo (x / 16) * rfMd (x / 16)) / rfM (x / 16) ^ 2 / 16) +
          (1 + 2 * x) * (rfNlo (x / 16) / rfM (x / 16)) - 1 =
          x / 16 * rfRlo (x / 16) / rfM (x / 16) ^ 2 := by
        rw [eq_div_iff (pow_ne_zero 2 hM.ne'), ← e]
        field_simp
        ring
      have hval : 2 * x * ((-kummerHalf x + exp (-x) * kummerMoment 1 x) -
          ((-(1 / 50000 : ℝ) * rfN (x / 16) + (1 - (1 / 50000 : ℝ) * (x / 16)) * rfNd (x / 16)) *
            rfM (x / 16) - rfNlo (x / 16) * rfMd (x / 16)) / rfM (x / 16) ^ 2 / 16) +
          (1 + 2 * x) * (kummerHalf x - rfNlo (x / 16) / rfM (x / 16)) =
          x / 16 * (-rfRlo (x / 16)) / rfM (x / 16) ^ 2 := by
        have : x / 16 * (-rfRlo (x / 16)) / rfM (x / 16) ^ 2 =
            -(x / 16 * rfRlo (x / 16) / rfM (x / 16) ^ 2) := by ring
        rw [this, ← k1]
        linarith [o]
      rw [hval]
      exact div_nonneg (mul_nonneg ht0 c1) (sq_nonneg _))
    (by simp [kummerHalf_zero, rfNlo, rfN, rfM])
  exact sub_nonneg.1 (key x ⟨h0, h1⟩)

/-- `g`'s lower bound on `[0, 16]`: `Â ≤ 32 g B` at `t = x/16`. -/
theorem rf_g_lo {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 16) :
    rfAhat (x / 16) ≤ 32 * robasG x * rfB (x / 16) := by
  have ht0 : 0 ≤ x / 16 := by linarith
  have ht1 : x / 16 ≤ 1 := by linarith
  have hM := rfM_pos ht0
  have hB := rfB_pos ht0 ht1
  have hphi := rfPhi_le_hi h0 h1
  have hgk := robasG_kummerHalf x
  have hg := robasG_pos x
  have hpos : 0 < 2 * x * robasG x + 1 := by positivity
  have h2 : rfM (x / 16) ≤ (2 * x * robasG x + 1) * rfB (x / 16) := by
    rw [le_div_iff₀ hM] at hphi
    nlinarith [mul_le_mul_of_nonneg_left hphi hpos.le]
  have hsp := rfAhat_spec (x / 16)
  rcases eq_or_lt_of_le h0 with hx0 | hxp
  · subst hx0
    rw [robasG_zero]
    simp only [zero_div] at hB ⊢
    have hB0 : rfB 0 = 1 := by unfold rfB rfN; norm_num
    rw [hB0]
    unfold rfAhat; norm_num
  · have ht : 0 < x / 16 := by linarith
    have : x / 16 * rfAhat (x / 16) ≤ x / 16 * (32 * robasG x * rfB (x / 16)) := by
      nlinarith
    exact le_of_mul_le_mul_left this ht

/-! #### `ω`, `ω′` and `c` on `y² ≤ 32` (`x ≤ 16`) -/

/-- `k = c/y`: `1 − 3g + 2xg(1 − g) = 2x(K₂/K₀ − g²)`, through the moment ODEs. -/
theorem robas_k_eq (x : ℝ) :
    1 - 3 * robasG x + 2 * x * robasG x * (1 - robasG x) =
      2 * x * (kummerMoment 2 x / kummerMoment 0 x - robasG x ^ 2) := by
  have o0 := kummerMoment_ode 0 x
  have o1 := kummerMoment_ode 1 x
  simp only [zero_add, Nat.reduceAdd, Nat.cast_zero, Nat.cast_one, mul_zero, mul_one] at o0 o1
  have h0 := (kummerMoment_pos 0 x).ne'
  unfold robasG
  field_simp
  linear_combination kummerMoment 0 x * o0 - kummerMoment 0 x * o1

theorem robas_k_nonneg {x : ℝ} (hx : 0 ≤ x) :
    0 ≤ 1 - 3 * robasG x + 2 * x * robasG x * (1 - robasG x) := by
  rw [robas_k_eq]
  have hK := kummerMoment_pos 0 x
  have hs := kummerMoment_sq_le x
  refine mul_nonneg (by linarith) ?_
  unfold robasG
  rw [div_pow, sub_nonneg, div_le_div_iff₀ (pow_pos hK 2) hK]
  nlinarith

theorem robasC_eq (y : ℝ) :
    robasC y = y * (2 * (1 - 3 * robasG (y ^ 2 / 2) +
      2 * (y ^ 2 / 2) * robasG (y ^ 2 / 2) * (1 - robasG (y ^ 2 / 2)))) := by
  unfold robasC robasOmega robasOmegaDeriv; ring

theorem robasC_nonneg {y : ℝ} (hy : 0 ≤ y) : 0 ≤ robasC y := by
  rw [robasC_eq]
  exact mul_nonneg hy (mul_nonneg (by norm_num) (robas_k_nonneg (by positivity)))

theorem robasOmega_nonneg {y : ℝ} (hy : 0 ≤ y) : 0 ≤ robasOmega y := by
  unfold robasOmega
  exact mul_nonneg (by positivity) (by linarith [robasG_le_one (y ^ 2 / 2)])

theorem rf_omega_le {y : ℝ} (hy : 0 ≤ y) (hy2 : y ^ 2 ≤ 32) : robasOmega y ≤ robasOmegaMax := by
  have hx0 : 0 ≤ y ^ 2 / 2 := by positivity
  have hx1 : y ^ 2 / 2 ≤ 16 := by linarith
  have ht0 : 0 ≤ y ^ 2 / 2 / 16 := by positivity
  have ht1 : y ^ 2 / 2 / 16 ≤ 1 := by linarith
  set t := y ^ 2 / 2 / 16 with ht
  set G := robasG (y ^ 2 / 2) with hG
  have hg := rf_g_lo hx0 hx1
  rw [← ht, ← hG] at hg
  have hB := rfB_pos ht0 ht1
  have c5 := rfCertC5 t ht0 ht1
  have h1 : robasOmega y * (16 * rfB t) ≤ y * (32 * rfB t - rfAhat t) := by
    unfold robasOmega
    rw [← hG]
    nlinarith [mul_le_mul_of_nonneg_left hg hy]
  have hy2' : y ^ 2 = 32 * t := by rw [ht]; ring
  have hbpos : 0 ≤ 16 * robasOmegaMax * rfB t := by unfold robasOmegaMax; positivity
  have h2 : (y * (32 * rfB t - rfAhat t)) ^ 2 ≤ (16 * robasOmegaMax * rfB t) ^ 2 := by
    rw [mul_pow, hy2']; unfold robasOmegaMax; nlinarith [c5]
  have h3 := (le_abs_self _).trans (abs_le_of_sq_le_sq'' h2 hbpos)
  have h4 : robasOmega y * (16 * rfB t) ≤ robasOmegaMax * (16 * rfB t) := by linarith
  exact le_of_mul_le_mul_right h4 (by positivity)

theorem rf_omegaDeriv_ge {y : ℝ} (hy2 : y ^ 2 ≤ 32) : robasOmegaDerivMin ≤ robasOmegaDeriv y := by
  have hx0 : 0 ≤ y ^ 2 / 2 := by positivity
  have hx1 : y ^ 2 / 2 ≤ 16 := by linarith
  have ht0 : 0 ≤ y ^ 2 / 2 / 16 := by positivity
  have ht1 : y ^ 2 / 2 / 16 ≤ 1 := by linarith
  set t := y ^ 2 / 2 / 16 with ht
  set G := robasG (y ^ 2 / 2) with hG
  have hg := rf_g_lo hx0 hx1
  rw [← ht, ← hG] at hg
  have hB := rfB_pos ht0 ht1
  have c6 := rfCertC6 t ht0 ht1
  have c7 := rfCertC7 t ht0 ht1
  have hsp := rfAhat_spec t
  set ε := 32 * G * rfB t - rfAhat t with hε
  have hε0 : 0 ≤ ε := by linarith
  have hx16 : y ^ 2 / 2 = 16 * t := by rw [ht]; ring
  have key : 16 * rfB t ^ 2 * robasOmegaDeriv y =
      rfAhat t * (2 * rfB t - 32 * t * rfB t + t * rfAhat t) +
        2 * ε * (rfM t - 16 * t * rfB t) + t * ε ^ 2 := by
    unfold robasOmegaDeriv
    rw [← hG, hx16, hε]
    linear_combination (-2 * (32 * G * rfB t - rfAhat t)) * hsp
  have h1 : 16 * rfB t ^ 2 * robasOmegaDerivMin ≤ 16 * rfB t ^ 2 * robasOmegaDeriv y := by
    rw [key]; unfold robasOmegaDerivMin
    nlinarith [mul_nonneg hε0 c6, mul_nonneg ht0 (sq_nonneg ε)]
  exact le_of_mul_le_mul_left h1 (by positivity)

/-- `c ≤ y e(y²/32)` on `y² ≤ 32`: `512 B² k(g) ≤ K̂ ≤ 512 e B²`. -/
theorem rf_c_le_env {y : ℝ} (hy : 0 ≤ y) (hy2 : y ^ 2 ≤ 32) :
    robasC y ≤ y * rfEnv (y ^ 2 / 2 / 16) := by
  have hx0 : 0 ≤ y ^ 2 / 2 := by positivity
  have hx1 : y ^ 2 / 2 ≤ 16 := by linarith
  have ht0 : 0 ≤ y ^ 2 / 2 / 16 := by positivity
  have ht1 : y ^ 2 / 2 / 16 ≤ 1 := by linarith
  set t := y ^ 2 / 2 / 16 with ht
  set G := robasG (y ^ 2 / 2) with hG
  have hg := rf_g_lo hx0 hx1
  rw [← ht, ← hG] at hg
  have hB := rfB_pos ht0 ht1
  have c8 := rfCertC8 t ht0 ht1
  have c10 := rfCertC10 t ht0 ht1
  have hks := rfKhat_spec t
  set ε := 32 * G * rfB t - rfAhat t with hε
  have hε0 : 0 ≤ ε := by linarith
  have hx16 : y ^ 2 / 2 = 16 * t := by rw [ht]; ring
  set k := 2 * (1 - 3 * G + 2 * (y ^ 2 / 2) * G * (1 - G)) with hk
  have key : rfKhat t - 512 * rfB t ^ 2 * k =
      32 * ε * (3 * rfB t + 2 * t * rfAhat t - 32 * t * rfB t) + 32 * t * ε ^ 2 := by
    rw [hk, hx16, hε]
    linear_combination hks
  have hk1 : 512 * rfB t ^ 2 * k ≤ 512 * rfB t ^ 2 * rfEnv t := by
    nlinarith [mul_nonneg hε0 c8, mul_nonneg ht0 (sq_nonneg ε)]
  have hk2 : k ≤ rfEnv t := le_of_mul_le_mul_left hk1 (by positivity)
  rw [robasC_eq, ← hG]
  exact mul_le_mul_of_nonneg_left hk2 hy

theorem rf_c_le {y : ℝ} (hy : 0 ≤ y) (hy2 : y ^ 2 ≤ 32) (K : ℝ) (hK : 0 ≤ K)
    (hcert : 0 ≤ K ^ 2 - 32 * (y ^ 2 / 2 / 16) * rfEnv (y ^ 2 / 2 / 16) ^ 2) : robasC y ≤ K := by
  have h1 := rf_c_le_env hy hy2
  set t := y ^ 2 / 2 / 16 with ht
  have hy2' : y ^ 2 = 32 * t := by rw [ht]; ring
  have h2 : (y * rfEnv t) ^ 2 ≤ K ^ 2 := by
    rw [mul_pow, hy2']; linarith
  have h3 := (le_abs_self _).trans (abs_le_of_sq_le_sq'' h2 hK)
  linarith

theorem rf_c_le_cmax {y : ℝ} (hy : 0 ≤ y) (hy2 : y ^ 2 ≤ 32) : robasC y ≤ robasCMax := by
  have ht0 : 0 ≤ y ^ 2 / 2 / 16 := by positivity
  have ht1 : y ^ 2 / 2 / 16 ≤ 1 := by linarith
  refine rf_c_le hy hy2 _ (by unfold robasCMax; norm_num) ?_
  unfold robasCMax
  exact rfCertC9e _ ht0 ht1

theorem rf_c_le_three {y : ℝ} (hy : 0 ≤ y) (hy1 : 16 ≤ y ^ 2) (hy2 : y ^ 2 ≤ 32) :
    robasC y ≤ 3 := by
  have ht0 : 1 / 2 ≤ y ^ 2 / 2 / 16 := by linarith
  have ht1 : y ^ 2 / 2 / 16 ≤ 1 := by linarith
  refine rf_c_le hy hy2 _ (by norm_num) ?_
  have := rfCertC12e _ ht0 ht1
  norm_num at this ⊢
  linarith

/-! #### The tail `x ≥ 16`: `(2x + 1)/(4x²) ≤ Φ ≤ (2x² + x + 2)/(4x³)` -/

theorem rf_T1 {x : ℝ} (hx : 16 ≤ x) :
    0 ≤ (18841 / 10000 : ℝ) ^ 2 * x * (2 * x ^ 2 + x + 2) ^ 2 -
      2 * (4 * x ^ 2 + 5 * x + 2) ^ 2 := by
  obtain ⟨s, hs, rfl⟩ : ∃ s, 0 ≤ s ∧ x = 16 + s := ⟨x - 16, by linarith, by ring⟩
  ring_nf; positivity

theorem rf_T2 {x : ℝ} (hx : 16 ≤ x) :
    0 ≤ 2 * (2 - 3 * x) - (-5511 / 10000 : ℝ) * (2 * x ^ 2 + x + 2) := by
  obtain ⟨s, hs, rfl⟩ : ∃ s, 0 ≤ s ∧ x = 16 + s := ⟨x - 16, by linarith, by ring⟩
  ring_nf; positivity

theorem rf_T3 {x : ℝ} (hx : 16 ≤ x) :
    0 ≤ (3 + 2 * x) * (2 * x ^ 2 + x + 2) - 2 * (4 * x ^ 2 + 5 * x + 2) := by
  obtain ⟨s, hs, rfl⟩ : ∃ s, 0 ≤ s ∧ x = 16 + s := ⟨x - 16, by linarith, by ring⟩
  ring_nf; positivity

theorem rf_T4 {x : ℝ} (hx : 16 ≤ x) :
    0 ≤ 9 * x * (2 * x ^ 2 + x + 2) ^ 4 - 2 * (-4 * x * (2 * x ^ 2 + x + 2) ^ 2 +
      (3 + 2 * x) * (4 * x ^ 2 + 5 * x + 2) * (2 * x ^ 2 + x + 2) -
        (4 * x ^ 2 + 5 * x + 2) ^ 2) ^ 2 := by
  obtain ⟨s, hs, rfl⟩ : ∃ s, 0 ≤ s ∧ x = 16 + s := ⟨x - 16, by linarith, by ring⟩
  ring_nf; positivity

theorem rf_tail_lo {x : ℝ} (hx : 16 ≤ x) : (2 * x + 1) / (4 * x ^ 2) ≤ kummerHalf x := by
  have key := nonneg_of_ode_ge (D := fun x => kummerHalf x - (2 * x + 1) / (4 * x ^ 2))
    (D' := fun x => (-kummerHalf x + exp (-x) * kummerMoment 1 x) -
      ((2 * (4 * x ^ 2) - (2 * x + 1) * (4 * (2 * x))) / (4 * x ^ 2) ^ 2))
    (x₀ := 16) (x₁ := x) (by norm_num)
    (fun z hz => by
      have hz0 : z ≠ 0 := by linarith [hz.1]
      have h := (((hasDerivAt_id z).const_mul 2).add_const 1).div
        ((hasDerivAt_pow 2 z).const_mul 4) (by positivity)
      refine (hasDerivAt_kummerHalf z).sub (h.congr_deriv ?_)
      simp only [id_eq]; push_cast; ring)
    (fun z hz => by
      have hz0 : 0 < z := by linarith [hz.1]
      have o := kummerHalf_ode z
      have k : 2 * z * ((2 * (4 * z ^ 2) - (2 * z + 1) * (4 * (2 * z))) / (4 * z ^ 2) ^ 2) +
          (1 + 2 * z) * ((2 * z + 1) / (4 * z ^ 2)) - 1 = -(3 / (4 * z ^ 2)) := by
        field_simp; ring
      have h3 : 0 ≤ 3 / (4 * z ^ 2) := by positivity
      nlinarith [k, o])
    (by
      have h := rfPhi_ge_lo (x := 16) (by norm_num) le_rfl
      have hv : (33 / 1024 : ℝ) ≤ rfNlo (16 / 16) / rfM (16 / 16) := by
        norm_num [rfNlo, rfN, rfM]
      norm_num at hv h ⊢
      linarith)
  exact sub_nonneg.1 (key x ⟨hx, le_rfl⟩)

theorem rf_tail_hi {x : ℝ} (hx : 16 ≤ x) : kummerHalf x ≤ (2 * x ^ 2 + x + 2) / (4 * x ^ 3) := by
  have key := nonneg_of_ode_ge (D := fun x => (2 * x ^ 2 + x + 2) / (4 * x ^ 3) - kummerHalf x)
    (D' := fun x => ((2 * (2 * x) + 1) * (4 * x ^ 3) - (2 * x ^ 2 + x + 2) * (4 * (3 * x ^ 2))) /
      (4 * x ^ 3) ^ 2 - (-kummerHalf x + exp (-x) * kummerMoment 1 x))
    (x₀ := 16) (x₁ := x) (by norm_num)
    (fun z hz => by
      have hz0 : z ≠ 0 := by linarith [hz.1]
      have h := ((((hasDerivAt_pow 2 z).const_mul 2).add (hasDerivAt_id z)).add_const 2).div
        ((hasDerivAt_pow 3 z).const_mul 4) (by positivity)
      refine (h.congr_deriv ?_).sub (hasDerivAt_kummerHalf z)
      simp only [id_eq, Pi.add_apply]; push_cast; ring)
    (fun z hz => by
      have hz0 : 0 < z := by linarith [hz.1]
      have o := kummerHalf_ode z
      have k : 2 * z * (((2 * (2 * z) + 1) * (4 * z ^ 3) -
          (2 * z ^ 2 + z + 2) * (4 * (3 * z ^ 2))) /
          (4 * z ^ 3) ^ 2) + (1 + 2 * z) * ((2 * z ^ 2 + z + 2) / (4 * z ^ 3)) - 1 =
          (z - 10) / (4 * z ^ 3) := by
        field_simp; ring
      have h3 : 0 ≤ (z - 10) / (4 * z ^ 3) := div_nonneg (by linarith [hz.1]) (by positivity)
      nlinarith [k, o])
    (by
      have h := rfPhi_le_hi (x := 16) (by norm_num) le_rfl
      have hv : rfB (16 / 16) / rfM (16 / 16) ≤ (530 / 16384 : ℝ) := by
        norm_num [rfB, rfN, rfM]
      norm_num at hv h ⊢
      linarith)
  exact sub_nonneg.1 (key x ⟨hx, le_rfl⟩)

/-- Past `x = 16`, `2x(2x² + x + 2)(1 − g) ≤ 4x² + 5x + 2`. -/
theorem rf_tail_W {x : ℝ} (hx : 16 ≤ x) :
    2 * x * (2 * x ^ 2 + x + 2) * (1 - robasG x) ≤ 4 * x ^ 2 + 5 * x + 2 := by
  have hphi := rf_tail_hi hx
  have hgk := robasG_kummerHalf x
  have hg := robasG_pos x
  have hx0 : 0 < x := by linarith
  have hpos : 0 < 2 * x * robasG x + 1 := by positivity
  have hD : 0 < 4 * x ^ 3 := by positivity
  rw [le_div_iff₀ hD] at hphi
  have : 4 * x ^ 3 ≤ (2 * x * robasG x + 1) * (2 * x ^ 2 + x + 2) := by
    nlinarith [mul_le_mul_of_nonneg_left hphi hpos.le]
  nlinarith

theorem rf_omega_tail {y : ℝ} (hy : 0 ≤ y) (hy2 : 32 ≤ y ^ 2) : robasOmega y ≤ robasOmegaMax := by
  set x := y ^ 2 / 2 with hx
  have hx16 : 16 ≤ x := by linarith
  have hx0 : 0 < x := by linarith
  have hW := rf_tail_W hx16
  have t1 := rf_T1 hx16
  set A := 4 * x ^ 2 + 5 * x + 2
  set D := 2 * x ^ 2 + x + 2
  have hD : 0 < D := by positivity
  have h1 : robasOmega y * (x * D) ≤ y * A := by
    unfold robasOmega; rw [← hx]
    nlinarith [mul_le_mul_of_nonneg_left hW hy]
  have hy2' : y ^ 2 = 2 * x := by rw [hx]; ring
  have hb : 0 ≤ robasOmegaMax * (x * D) := by unfold robasOmegaMax; positivity
  have h2 : (y * A) ^ 2 ≤ (robasOmegaMax * (x * D)) ^ 2 := by
    rw [mul_pow, hy2']; unfold robasOmegaMax; nlinarith [mul_nonneg hx0.le t1]
  have h3 := (le_abs_self _).trans (abs_le_of_sq_le_sq'' h2 hb)
  have h4 : robasOmega y * (x * D) ≤ robasOmegaMax * (x * D) := by linarith
  exact le_of_mul_le_mul_right h4 (by positivity)

theorem rf_omegaDeriv_tail {y : ℝ} (hy2 : 32 ≤ y ^ 2) : robasOmegaDerivMin ≤ robasOmegaDeriv y := by
  set x := y ^ 2 / 2 with hx
  have hx16 : 16 ≤ x := by linarith
  have hx0 : 0 < x := by linarith
  have hW := rf_tail_W hx16
  have t2 := rf_T2 hx16
  have hg := robasG_pos x
  have hg1 := robasG_le_one x
  set D := 2 * x ^ 2 + x + 2
  have hD : 0 < D := by positivity
  unfold robasOmegaDeriv robasOmegaDerivMin
  rw [← hx]
  set G := robasG x
  rcases le_or_gt 0 (1 - x * (1 - G)) with h | h
  · nlinarith [mul_nonneg hg.le h]
  · have h1 : 4 * (1 - x * (1 - G)) ≤ 4 * G * (1 - x * (1 - G)) := by nlinarith
    have h2 : (-5511 / 10000 : ℝ) * D ≤ 4 * (1 - x * (1 - G)) * D := by nlinarith
    have h3 := le_of_mul_le_mul_right h2 hD
    linarith

theorem rf_c_tail {y : ℝ} (hy : 0 ≤ y) (hy2 : 32 ≤ y ^ 2) : robasC y ≤ 3 := by
  set x := y ^ 2 / 2 with hx
  have hx16 : 16 ≤ x := by linarith
  have hx0 : 0 < x := by linarith
  have hW := rf_tail_W hx16
  have t3 := rf_T3 hx16
  have t4 := rf_T4 hx16
  have hg1 := robasG_le_one x
  set A := 4 * x ^ 2 + 5 * x + 2
  set D := 2 * x ^ 2 + x + 2
  have hD : 0 < D := by positivity
  set Z := 2 * x * D * (1 - robasG x) with hZ
  have hZ0 : 0 ≤ Z := by rw [hZ]; have := hg1; positivity
  set F := -4 * x * D ^ 2 + (3 + 2 * x) * A * D - A ^ 2 with hF
  set k := 2 * (1 - 3 * robasG x + 2 * x * robasG x * (1 - robasG x)) with hk
  have hkZ : k * (x * D ^ 2) = -4 * x * D ^ 2 + (3 + 2 * x) * D * Z - Z ^ 2 := by
    rw [hk, hZ]; ring
  have hkF : k * (x * D ^ 2) ≤ F := by
    rw [hkZ, hF]
    nlinarith [mul_nonneg (sub_nonneg.2 hW) t3, mul_nonneg (sub_nonneg.2 hW) (sub_nonneg.2 hW)]
  have hc : robasC y = y * k := by rw [robasC_eq, ← hx]
  have hy2' : y ^ 2 = 2 * x := by rw [hx]; ring
  have hb : 0 ≤ 3 * (x * D ^ 2) := by positivity
  have h2 : (y * F) ^ 2 ≤ (3 * (x * D ^ 2)) ^ 2 := by
    rw [mul_pow, hy2']; nlinarith [mul_nonneg hx0.le t4]
  have h3 := (le_abs_self _).trans (abs_le_of_sq_le_sq'' h2 hb)
  have h4 : robasC y * (x * D ^ 2) ≤ 3 * (x * D ^ 2) := by
    rw [hc]; nlinarith [mul_le_mul_of_nonneg_left hkF hy]
  exact le_of_mul_le_mul_right h4 (by positivity)

/-! #### The four bounds, and the interval theorem without hypotheses -/

theorem robasOmega_neg (y : ℝ) : robasOmega (-y) = -robasOmega y := by
  unfold robasOmega; rw [neg_sq]; ring

theorem robasOmegaDeriv_neg (y : ℝ) : robasOmegaDeriv (-y) = robasOmegaDeriv y := by
  unfold robasOmegaDeriv; rw [neg_sq]

theorem robasC_neg (y : ℝ) : robasC (-y) = -robasC y := by
  unfold robasC; rw [robasOmega_neg, robasOmegaDeriv_neg]; ring

theorem robasBigOmega_neg (y : ℝ) : robasBigOmega (-y) = robasBigOmega y := by
  unfold robasBigOmega; rw [neg_sq]

theorem robasKappa_neg (y : ℝ) : robasKappa (-y) = robasKappa y := by
  unfold robasKappa; rw [robasBigOmega_neg, robasOmega_neg]; ring

theorem robasKappa_abs (y : ℝ) : robasKappa |y| = robasKappa y := by
  rcases le_total 0 y with hy | hy
  · rw [abs_of_nonneg hy]
  · rw [abs_of_nonpos hy, robasKappa_neg]

theorem robasOmega_le {y : ℝ} (hy : 0 ≤ y) : robasOmega y ≤ robasOmegaMax :=
  (le_total (y ^ 2) 32).elim (rf_omega_le hy) (rf_omega_tail hy)

theorem robasOmega_abs_le (y : ℝ) : |robasOmega y| ≤ robasOmegaMax := by
  rcases le_total 0 y with hy | hy
  · rw [abs_of_nonneg (robasOmega_nonneg hy)]; exact robasOmega_le hy
  · have h := robasOmega_le (y := -y) (by linarith)
    have h0 := robasOmega_nonneg (y := -y) (by linarith)
    rw [robasOmega_neg] at h h0
    rw [abs_of_nonpos (by linarith)]
    linarith

theorem robasOmegaDeriv_ge (y : ℝ) : robasOmegaDerivMin ≤ robasOmegaDeriv y :=
  (le_total (y ^ 2) 32).elim rf_omegaDeriv_ge rf_omegaDeriv_tail

theorem robasC_le {y : ℝ} (hy : 0 ≤ y) : robasC y ≤ robasCMax := by
  rcases le_total (y ^ 2) 32 with h | h
  · exact rf_c_le_cmax hy h
  · have := rf_c_tail hy h
    unfold robasCMax; linarith

theorem robasC_abs_le (y : ℝ) : |robasC y| ≤ robasCMax := by
  rcases le_total 0 y with hy | hy
  · rw [abs_of_nonneg (robasC_nonneg hy)]; exact robasC_le hy
  · have h := robasC_le (y := -y) (by linarith)
    have h0 := robasC_nonneg (y := -y) (by linarith)
    rw [robasC_neg] at h h0
    rw [abs_of_nonpos (by linarith)]
    linarith

theorem robasC_le_three {y : ℝ} (hy : 4 ≤ y) : robasC y ≤ 3 := by
  rcases le_total (y ^ 2) 32 with h | h
  · exact rf_c_le_three (by linarith) (by nlinarith) h
  · exact rf_c_tail (by linarith) h

theorem robasKappa_monotoneOn : MonotoneOn robasKappa (Set.Ici 0) := by
  refine monotoneOn_of_deriv_nonneg (convex_Ici 0) ?_ ?_ ?_
  · exact fun y _ => (hasDerivAt_robasKappa y).continuousAt.continuousWithinAt
  · intro y _; exact (hasDerivAt_robasKappa y).differentiableAt.differentiableWithinAt
  · intro y hy
    rw [interior_Ici] at hy
    rw [(hasDerivAt_robasKappa y).deriv]
    exact robasC_nonneg (le_of_lt hy)

/-- `κ`'s increment over `[a, a + L]` for `a ≥ 0`: under the envelope's for `a ≤ 4`, under `3L`
past it. -/
theorem rf_kappa_window {a L W : ℝ} (ha : 0 ≤ a) (hL0 : 0 ≤ L) (hL : L ≤ 1415 / 1000)
    (hW3 : 3 * L ≤ W)
    (hC13 : ∀ t : ℝ, 0 ≤ t → t ≤ 4 → rfEnvInt ((L + t) ^ 2 / 32) - rfEnvInt (t ^ 2 / 32) ≤ W) :
    robasKappa (a + L) - robasKappa a ≤ W := by
  rcases eq_or_lt_of_le hL0 with hL00 | hLp
  · rw [← hL00, add_zero, sub_self]; linarith
  rcases le_or_gt a 4 with ha4 | ha4
  · set h : ℝ → ℝ := fun y => robasKappa y - rfEnvInt (y ^ 2 / 32)
    have hd : ∀ y, HasDerivAt h (robasC y - y * rfEnv (y ^ 2 / 32)) y := by
      intro y
      have h2 := (hasDerivAt_rfEnvInt (y ^ 2 / 32)).comp y ((hasDerivAt_pow 2 y).div_const 32)
      refine (hasDerivAt_robasKappa y).sub (h2.congr_deriv ?_)
      push_cast; ring
    obtain ⟨ξ, hξ, hs⟩ := exists_hasDerivAt_eq_slope h (fun y => robasC y - y * rfEnv (y ^ 2 / 32))
      (by linarith : a < a + L) (fun y _ => (hd y).continuousAt.continuousWithinAt)
      (fun y _ => hd y)
    have hξ0 : 0 ≤ ξ := by linarith [hξ.1]
    have hξ2 : ξ ^ 2 ≤ 32 := by nlinarith [hξ.2]
    have henv := rf_c_le_env hξ0 hξ2
    have e32 : ξ ^ 2 / 2 / 16 = ξ ^ 2 / 32 := by ring
    rw [e32] at henv
    have hneg : h (a + L) - h a ≤ 0 := by
      rw [eq_div_iff (by linarith : a + L - a ≠ 0)] at hs
      rw [← hs]
      exact mul_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
    have hc := hC13 a ha ha4
    simp only [h] at hneg
    rw [add_comm L a] at hc
    linarith
  · obtain ⟨ξ, hξ, hs⟩ := exists_hasDerivAt_eq_slope robasKappa robasC (by linarith : a < a + L)
      (fun y _ => (hasDerivAt_robasKappa y).continuousAt.continuousWithinAt)
      (fun y _ => hasDerivAt_robasKappa y)
    have hc := robasC_le_three (by linarith [hξ.1] : (4 : ℝ) ≤ ξ)
    rw [eq_div_iff (by linarith : a + L - a ≠ 0)] at hs
    nlinarith

/-- `κ` is even and nondecreasing on `[0, ∞)`, so a window bound for `a ≥ 0` gives one for all
`a, b`. -/
theorem robasKappa_window {L W : ℝ} (hgood : ∀ a, 0 ≤ a → robasKappa (a + L) - robasKappa a ≤ W)
    (a b : ℝ) (hab : |b - a| ≤ L) : |robasKappa b - robasKappa a| ≤ W := by
  rw [← robasKappa_abs a, ← robasKappa_abs b]
  have hmono := robasKappa_monotoneOn
  have hL : 0 ≤ L := (abs_nonneg _).trans hab
  have hd : abs (|b| - |a|) ≤ L := (abs_abs_sub_abs_le_abs_sub b a).trans hab
  rcases le_total |a| |b| with h | h
  · have hb : |b| ≤ |a| + L := by linarith [(abs_le.1 hd).2]
    have h1 := hmono (abs_nonneg a) (abs_nonneg b) h
    have h2 := hmono (abs_nonneg b) (by linarith [abs_nonneg a] : (0 : ℝ) ≤ |a| + L) hb
    have h3 := hgood |a| (abs_nonneg a)
    rw [abs_of_nonneg (by linarith)]
    linarith
  · have ha : |a| ≤ |b| + L := by linarith [(abs_le.1 hd).1]
    have h1 := hmono (abs_nonneg b) (abs_nonneg a) h
    have h2 := hmono (abs_nonneg a) (by linarith [abs_nonneg b] : (0 : ℝ) ≤ |b| + L) ha
    have h3 := hgood |b| (abs_nonneg b)
    rw [abs_of_nonpos (by linarith)]
    linarith

/-- **The four bounds on Dawson's function hold**: `|ω| ≤ 1.8841`, `ω′ ≥ −0.5511`,
`|c| ≤ 3.2365`, and `κ`'s window increments, by rational brackets of `Φ` from its ODE and
polynomial certificates. -/
theorem robasDawsonBounds : RobasDawsonBounds where
  omega := robasOmega_abs_le
  omegaDeriv := robasOmegaDeriv_ge
  c := robasC_abs_le
  windowLong := by
    refine robasKappa_window (fun a ha => ?_)
    unfold robasWindowLong robasWindowLongBound
    refine rf_kappa_window ha (by norm_num) (by norm_num) (by norm_num) fun t h0 h4 => ?_
    have := rfCertC13L t h0 h4
    linarith
  windowShort := by
    refine robasKappa_window (fun a ha => ?_)
    unfold robasWindowShort robasWindowShortBound
    refine rf_kappa_window ha (by norm_num) (by norm_num) (by norm_num) fun t h0 h4 => ?_
    have := rfCertC13S t h0 h4
    linarith

/-- **RoBAS-Full's conformal sets are intervals for `n ≥ 4`**, with no hypotheses beyond the
calibration residuals not all being equal: `robasFull_interval` with `robasDawsonBounds`. -/
theorem robasFull_ordConnected {n : ℕ} (hn : 4 ≤ n) (r : Fin n → ℝ) (hr : ∃ i k, r i ≠ r k)
    (α : ℝ) : Set.OrdConnected {z | α < robasPValue r z} :=
  robasFull_interval robasDawsonBounds hn r hr α

end RobasDawsonCert

end Conformal
