import Enthymemata.ConformalValidity

/-!
# RoBAS-Full's four Dawson bounds, proved

`ConformalValidity`'s `robasFull_interval` proves RoBAS-Full's conformal sets are intervals for
`n ≥ 4`, granted `RobasDawsonBounds`: four bounds on `ω`, `ω′`, `c` and `κ`, built from the module's
own `₁F₁(1; 3/2; −x) = e^{−x} ∫₀¹ e^{x v²} dv`. This file proves them (`robasDawsonBounds`), so
`robasFull_ordConnected` holds with no hypothesis on Dawson's function.

* **Φ's ODE.** `2x Φ′ + (1 + 2x) Φ = 1` and `(2x g + 1) Φ = 1` (`kummerHalf_ode`,
  `robasG_kummerHalf`); a comparison principle with the weight `√x eˣ` (`nonneg_of_ode_ge`).
* **A rational bracket on `[0, 16]`.** `P = N/M` of degree `(5, 6)` in `t = x/16`, with
  `N(0) = M(0) = 1` and `P′(0) = Φ′(0)`; `(1 − δt) P ≤ Φ ≤ (1 + δt) P` with `δ = 1/50000`
  (`rfPhi_ge_lo`, `rfPhi_le_hi`), so `g ≥ Â/(32 B)` (`rf_g_lo`). Past `16`,
  `(2x + 1)/(4x²) ≤ Φ ≤ (2x² + x + 2)/(4x³)` (`rf_tail_lo`, `rf_tail_hi`).
* **Polynomial certificates.** Each polynomial inequality on an interval is certified by positive
  Bernstein coefficients: a Taylor shift and a homogeneous identity in free `u, v`, checked by
  `ring`, then `positivity`. The polynomials and coefficients are generated exactly in rationals.
* **The bounds.** `ω`, `ω′` and `c` on `x ≤ 16` from the bracket; `c ≤ y e(x)` for an envelope `e`
  whose antiderivative bounds `κ`'s window increments; the tail by its sub- and supersolution.
-/

open Finset

namespace Conformal

section RobasDawsonCert

open Real Set Filter MeasureTheory Topology

theorem kummerMoment_zero (j : ℕ) : kummerMoment j 0 = 1 / (2 * j + 1) := by
  unfold kummerMoment
  simp only [zero_mul, exp_zero, mul_one]
  rw [integral_pow]
  push_cast
  ring

theorem kummerHalf_zero : kummerHalf 0 = 1 := by
  unfold kummerHalf
  rw [kummerMoment_zero]
  simp

theorem robasG_zero : robasG 0 = 1 / 3 := by
  unfold robasG
  rw [kummerMoment_zero, kummerMoment_zero]
  norm_num

theorem hasDerivAt_kummerHalf (x : ℝ) :
    HasDerivAt kummerHalf (-kummerHalf x + exp (-x) * kummerMoment 1 x) x := by
  have h := ((hasDerivAt_neg x).exp).mul (hasDerivAt_kummerMoment 0 x)
  refine h.congr_deriv ?_
  unfold kummerHalf
  ring

/-- `Φ = ₁F₁(1; 3/2; −x)` solves `2x Φ′ + (1 + 2x) Φ = 1`. -/
theorem kummerHalf_ode (x : ℝ) :
    2 * x * (-kummerHalf x + exp (-x) * kummerMoment 1 x) + (1 + 2 * x) * kummerHalf x = 1 := by
  have o := kummerMoment_ode 0 x
  simp only [zero_add, Nat.cast_zero, mul_zero] at o
  unfold kummerHalf
  have : exp (-x) * exp x = 1 := by rw [← exp_add]; simp
  linear_combination exp (-x) * o + this

/-- `(2x g + 1) Φ = 1`. -/
theorem robasG_kummerHalf (x : ℝ) : (2 * x * robasG x + 1) * kummerHalf x = 1 := by
  have o := kummerMoment_ode 0 x
  simp only [zero_add, Nat.cast_zero, mul_zero] at o
  have h0 := (kummerMoment_pos 0 x).ne'
  unfold robasG kummerHalf
  have : exp (-x) * exp x = 1 := by rw [← exp_add]; simp
  field_simp
  linear_combination exp (-x) * o + this

/-- The comparison for `2x D′ + (1 + 2x) D ≥ 0`: with the weight `√x eˣ` it cannot fall below a
nonnegative start. -/
theorem nonneg_of_ode_ge {D D' : ℝ → ℝ} {x₀ x₁ : ℝ} (h0 : 0 ≤ x₀)
    (hD : ∀ x ∈ Set.Icc x₀ x₁, HasDerivAt D (D' x) x)
    (hode : ∀ x ∈ Set.Icc x₀ x₁, 0 ≤ 2 * x * D' x + (1 + 2 * x) * D x) (hx₀ : 0 ≤ D x₀) :
    ∀ x ∈ Set.Icc x₀ x₁, 0 ≤ D x := by
  set w : ℝ → ℝ := fun x => sqrt x * exp x * D x
  have hw : ∀ x, 0 < x → x ∈ Set.Icc x₀ x₁ → HasDerivAt w
      (exp x * (2 * x * D' x + (1 + 2 * x) * D x) / (2 * sqrt x)) x := by
    intro x hx hxI
    have hs := hasDerivAt_sqrt hx.ne'
    have := ((hs.mul (hasDerivAt_exp x)).mul (hD x hxI))
    refine this.congr_deriv ?_
    have hsx : sqrt x ^ 2 = x := sq_sqrt hx.le
    have hs0 : sqrt x ≠ 0 := (sqrt_pos.2 hx).ne'
    simp only [Pi.mul_apply]
    field_simp
    linear_combination (2 * D x + 2 * D' x) * hsx
  have hmono : MonotoneOn w (Set.Icc x₀ x₁) := by
    refine monotoneOn_of_deriv_nonneg (convex_Icc x₀ x₁) ?_ ?_ ?_
    · intro x hx
      by_cases hxp : 0 < x
      · exact (hw x hxp hx).continuousAt.continuousWithinAt
      · have hx0 : x = 0 := le_antisymm (not_lt.1 hxp) (h0.trans hx.1)
        have hc : ContinuousAt (fun x => sqrt x * exp x) x :=
          (continuous_sqrt.mul continuous_exp).continuousAt
        have hDc : ContinuousWithinAt D (Set.Icc x₀ x₁) x :=
          (hD x hx).continuousAt.continuousWithinAt
        exact hc.continuousWithinAt.mul hDc
    · intro x hx
      rw [interior_Icc] at hx
      exact (hw x (lt_of_le_of_lt h0 hx.1)
        ⟨hx.1.le, hx.2.le⟩).differentiableAt.differentiableWithinAt
    · intro x hx
      rw [interior_Icc] at hx
      have hxp : 0 < x := lt_of_le_of_lt h0 hx.1
      rw [(hw x hxp ⟨hx.1.le, hx.2.le⟩).deriv]
      exact div_nonneg (mul_nonneg (exp_pos _).le (hode x ⟨hx.1.le, hx.2.le⟩))
        (by positivity)
  intro x hx
  have hx0I : x₀ ∈ Set.Icc x₀ x₁ := ⟨le_rfl, hx.1.trans hx.2⟩
  have key := hmono hx0I hx hx.1
  have hw0 : 0 ≤ w x₀ := mul_nonneg (mul_nonneg (sqrt_nonneg _) (exp_pos _).le) hx₀
  rcases eq_or_lt_of_le (h0.trans hx.1) with hx0 | hxp
  · have h1 : x₀ = x := le_antisymm hx.1 (hx0 ▸ h0)
    rw [← h1]
    exact hx₀
  · have hpos : 0 < sqrt x * exp x := mul_pos (sqrt_pos.2 hxp) (exp_pos _)
    have : 0 ≤ sqrt x * exp x * D x := hw0.trans key
    exact le_of_mul_le_mul_left (by rw [mul_zero]; exact this) hpos

